      "html": "<div class=\"ds-switches\"><button type=\"button\" role=\"switch\" aria-checked=\"true\" aria-label=\"Notifications on\" class=\"ds-switch\"><span></span></button><button type=\"button\" role=\"switch\" aria-checked=\"false\" aria-label=\"Notifications off\" class=\"ds-switch\"><span></span></button></div>",
