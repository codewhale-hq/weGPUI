      "html": "<nav class=\"ds-conversations\" aria-label=\"Conversation selection examples\"><button type=\"button\" class=\"ds-conversation ds-reference\" aria-selected=\"true\"><span class=\"ds-avatar\">MC</span><span class=\"ds-row-copy\"><span class=\"ds-row-title\">Design studio</span><span class=\"ds-row-preview\">Morgan: The prototype is ready.</span></span><span class=\"ds-row-time\">09:41</span></button><button type=\"button\" class=\"ds-conversation ds-care\" aria-selected=\"true\"><span class=\"ds-avatar\">MC</span><span class=\"ds-row-copy\"><span class=\"ds-row-title\">Design studio · Care</span><span class=\"ds-row-preview\">Morgan: The prototype is ready.</span></span><span class=\"ds-row-time\">09:41</span></button></nav>",
      "css": ".ds-conversations{max-width:340px;background:#eeeef0}.ds-conversation{display:flex;align-items:center;width:100%;gap:10px;padding:10px 12px;border:0;border-radius:5px;background:#1cac72;text-align:left;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;line-height:1.3;cursor:pointer}.ds-reference{color:#fff}.ds-avatar{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:38px;height:38px;border-radius:5px;background:#647f72;color:#000;font-size:12.16px;font-weight:500}.ds-row-copy{display:flex;flex-direction:column;gap:5px;flex:1;min-width:0}.ds-row-title{font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-row-preview{font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-row-time{font-size:10px;align-self:flex-start}.ds-reference .ds-row-preview,.ds-reference .ds-row-time{color:rgba(255,255,255,.7)}.ds-care{color:#000}.ds-care .ds-row-preview,.ds-care .ds-row-time{color:#000}.ds-conversation:hover{opacity:.88}.ds-conversation:active{opacity:.65}.ds-conversation:focus-visible{outline:none;box-shadow:inset 0 0 0 4px #000,inset 0 0 0 2px #fff}"
    },
    {
