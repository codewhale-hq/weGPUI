  "components": [
    {
      "name": "Desktop Primary Button",
      "kind": "button",
      "refersTo": "desktop-button-primary",
      "description": "CSS translation of the default-light native primary button; the actual native foreground is calculated from the current brand.",
      "html": "<button type=\"button\" class=\"ds-button ds-primary\">Send</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:34px;padding:0 12px;border:0;border-radius:5px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:13px;line-height:1.3;cursor:pointer}.ds-button:focus-visible{outline:none;box-shadow:inset 0 0 0 4px #000,inset 0 0 0 2px #fff}.ds-button:active:not(:disabled){opacity:.65}.ds-button:disabled{opacity:.4;cursor:default}.ds-primary{background:#07c160;color:#000}.ds-primary:hover:not(:disabled){opacity:.88}"
    },
    {
      "name": "Desktop Filled Button",
      "kind": "button",
      "refersTo": "desktop-button-filled",
      "description": "Default-light field surface with primary text, used for secondary actions.",
      "html": "<button type=\"button\" class=\"ds-button ds-filled\">Open file</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:34px;padding:0 12px;border:0;border-radius:5px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:13px;line-height:1.3;cursor:pointer}.ds-button:focus-visible{outline:none;box-shadow:inset 0 0 0 4px #000,inset 0 0 0 2px #fff}.ds-button:active:not(:disabled){opacity:.65}.ds-button:disabled{opacity:.4;cursor:default}.ds-filled{background:#e6e6e8;color:#1a1a1c}.ds-filled:hover:not(:disabled){background:#ececec}"
    },
