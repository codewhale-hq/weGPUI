      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:34px;padding:0 12px;border:0;border-radius:5px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:13px;line-height:1.3;cursor:pointer}.ds-button:focus-visible{outline:none;box-shadow:inset 0 0 0 4px #000,inset 0 0 0 2px #fff}.ds-button:active:not(:disabled){opacity:.65}.ds-button:disabled{opacity:.4;cursor:default}.ds-quiet{background:transparent;color:#1a1a1c}.ds-quiet:hover:not(:disabled){background:#ececec}"
