  "narrative": {
    "northStar": "The Native Mac Component Catalog",
    "overview": "The native desktop collection uses the compact geometry, pane relationships and system typography of a modern Mac chat interface. Quiet neutral surfaces carry conversations, controls and content; green identifies a small set of meaningful states. The mobile collection retains its WeUI identity. Both collections follow the existing global `Theme`, while desktop surfaces keep their own sampled Mac roles.\n\nThe website is a restrained visual catalog. Real native renders, readable labels and source material carry its character. Its white canvas and modest controls give the component examples room to be inspected. The original desktop collection and the WeUI mobile ports remain identifiable within the same catalog.\n\nThis records the implemented system in [DesktopPalette and controls](src/desktop/controls.rs), [messages](src/desktop/messaging.rs), [panels](src/desktop/panels.rs), [icons](src/desktop/icons.rs), [native composition](examples/gallery/pages/macos.rs) and [catalog styles](website/style.css). The sampled surface map and compatibility limits live in [DESKTOP.md](docs/DESKTOP.md); the full mobile palette remains in [tokens.json](docs/tokens.json). This is a visual reference, not a statement of complete platform or accessibility acceptance.",
    "keyCharacteristics": [
      "Compact Mac controls within clearly differentiated panes.",
      "Sampled desktop neutrals with shared WeUI control accents.",
      "Native system type, small radii and original geometric icons.",
      "A quiet catalog that presents actual native component captures."
    ],
    "rules": [
      {
        "name": "The Sampled Surface Rule",
        "body": "Keep canvas, list, rail, pinned, panel, field and bubble roles distinct using the current `DesktopPalette`; mobile surface aliases do not replace the sampled Mac map.",
        "section": "colors"
      },
      {
        "name": "The One Theme Rule",
        "body": "Light, dark, care and brand changes resolve through the existing global `Theme`; component collections do not create independent appearance state.",
        "section": "colors"
      },
      {
        "name": "The Native Type Rule",
        "body": "Use the platform UI family for native controls and content; use monospace for code and identifiers.",
        "section": "typography"
      },
      {
        "name": "The Surface Before Shadow Rule",
        "body": "Separate persistent native panes with their surface roles and dividers; reserve ambient shadow for floating layers.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use the sampled Mac surface roles for the desktop collection and the existing WeUI palette for the mobile collection.",
      "**Do** keep both collections connected to the existing global Theme, including light, dark, care and brand state.",
      "**Do** retain native system typography, compact component geometry and the original SVG icon vocabulary.",
      "**Do** preserve focus, disabled, selected, error and loading presentation when composing reusable controls.",
      "**Do** keep incoming and outgoing bubble tails aligned with their direction and colored from the bubble surface.",
      "**Do** describe the ordinary selected-row white text as the approved reference compatibility treatment and expose the care-mode alternative."
    ],
    "donts": [
      "**Don't** replace sampled desktop surfaces with generic green-tinted or mobile surface mappings.",
      "**Don't** apply the selected-row contrast exception as a general legibility rule or claim full AA acceptance.",
      "**Don't** turn synthetic avatar colors into new theme tokens.",
      "**Don't** replace the original geometric SVG icons with text glyph approximations.",
      "**Don't** add persistent pane shadows where the existing surface and divider hierarchy provides separation."
    ]
  }
}
