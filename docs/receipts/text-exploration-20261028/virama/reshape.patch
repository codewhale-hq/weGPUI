         SmallVec<[WrapBoundary; 1]>,
         SmallVec<[usize; 1]>,
     )> {
+        if text.as_ref() == "လိ္က"
+            && unwrapped.width > wrap_width
+            && overflow_wrap == OverflowWrap::Normal
+            && max_lines.is_none_or(|max| max >= 2)
