+}
+
+impl ModalLayers {
+    fn register(&mut self, depth: usize) -> Rc<Cell<bool>> {
+        if self.top.as_ref().is_some_and(|(top, _)| *top > depth) {
+            return Rc::new(Cell::new(true));
+        }
+        let hidden = Rc::new(Cell::new(false));
