+    #[test]
+    fn test_is_word_char_neighbouring_scripts_are_unchanged() {
+        for c in ['\u{058F}', '\u{0700}', '\u{0E01}', '\u{1100}', '\u{AC00}', '\u{4F60}'] {
+            assert!(
