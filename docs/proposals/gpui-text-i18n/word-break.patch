+    #[test]
+    fn test_is_word_char_arabic() {
+        for word in [
+            "مرحبا",
+            "بالعالم،",
+            "ٱلْكِتَابُ",
+            "١٢٣",
+            "ݐݑݒ",
+            "ࢠࢡࢢ",
+            "ﭐﭑﭒ",
+            "ﷲ",
+            "ﺎﺏ",
+        ] {
+            for c in word.chars() {
+                assert!(
+                    LineWrapper::is_word_char(c),
+                    "assertion failed for '{}' (unicode 0x{:x}) in {:?}",
+                    c,
+                    c as u32,
+                    word
+                );
+            }
+        }
+    }
+
