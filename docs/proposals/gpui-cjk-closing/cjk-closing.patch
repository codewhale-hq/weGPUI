+++ b/vendor/gpui_pre/src/text_system/line_wrapper.rs
@@ -540,6 +540,9 @@
         // `⋯` character is special used in Zed, to keep this at the end of the line.
         matches!(c, '⋯') ||
 
+        matches!(c, '、' | '。' | '，' | '．' | '：' | '；' | '！' | '？' |
